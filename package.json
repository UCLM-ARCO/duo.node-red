{
  "name": "node-red-contrib-idm",
  "version": "0.3.3",
  "description": "Nodes for IDM: configuration and DUO.IBool",
  "homepage": "https://bitbucket.org/arco_group/idm",
  "dependencies": {
    "ice": ">=3.6.1"
  },
  "node-red": {
    "nodes": {
      "Active in": "duo-active-in.js",
      "Active out": "duo-active-out.js",
      "IBool in": "duo-ibool-in.js",
      "IBool out": "duo-ibool-out.js",
      "IInt in": "duo-iint-in.js",
      "IInt out": "duo-iint-out.js",
      "IString in": "duo-istring-in.js",
      "IString out": "duo-istring-out.js",
      "toggle in": "toggle-in.js",
