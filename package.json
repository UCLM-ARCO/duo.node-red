{
  "name": "node-red-contrib-idm",
  "version": "0.4.5",
  "description": "Nodes for IDM and DUO",
  "homepage": "https://bitbucket.org/arco_group/idm",
  "author": "Arco Research Group - University of Castilla-La Mancha",
  "dependencies": {
    "idm-slice": "*",
    "ice": ">=3.6.1"
  },
  "keywords": [
    "node-red",
    "idm",
    "integration",
    "arduino",
    "esp8266",
    "duo",
    "zeroc-ice"
  ],
  "node-red": {
    "nodes": {
      "Active in": "duo-active-in.js",
      "Active out": "duo-active-out.js",
      "IBool in": "duo-ibool-in.js",
      "IBool out": "duo-ibool-out.js",
      "IByte in": "duo-ibyte-in.js",
      "IByte out": "duo-ibyte-out.js",
      "IInt in": "duo-iint-in.js",
      "IInt out": "duo-iint-out.js",
      "IString in": "duo-istring-in.js",
      "IString out": "duo-istring-out.js",
      "toggle in": "toggle-in.js",
      "toggle out": "toggle-out.js",
      "ice-adapter": "ice-adapter-config.js",
      "ice-communicator": "ice-communicator-config.js",
      "idm-router": "idm-router-config.js",
      "duo-wiring-service": "duo-wiring-service-config.js"
    }
  }
}
